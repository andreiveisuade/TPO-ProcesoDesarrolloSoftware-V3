vars: {
  d2-config: {
    theme-id: 0
    pad: 20
  }
}
classes: {
  capa: {style: {fill: "#EEF4FB"; stroke: "#2E75B6"; font-color: "#1D2B4F"; border-radius: 6; font-size: 20; bold: true}}
  cl: {style: {fill: "#FFFFFF"; stroke: "#1D2B4F"; font-color: "#222222"; border-radius: 3; font-size: 18}}
  rol: {style: {fill: "#FFFFFF"; stroke: "#2E75B6"; font-color: "#1D2B4F"; border-radius: 3; font-size: 18; stroke-width: 2}}
  ext: {style: {fill: "#F4F4F4"; stroke: "#666666"; font-color: "#444444"; stroke-dash: 4; font-size: 18}}
}
