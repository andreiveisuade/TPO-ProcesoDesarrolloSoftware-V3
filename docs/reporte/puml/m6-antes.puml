@startuml
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 12
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #1D2B4F
skinparam ClassHeaderBackgroundColor #FFFFFF
skinparam ArrowColor #2E75B6
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #B38600
skinparam SequenceLifeLineBorderColor #1D2B4F
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #1D2B4F
skinparam SequenceGroupBackgroundColor #F4F8FC
hide empty members
interface ICuota {
  +estaPagada()
  +getFechaVencimiento()
}
class Cuota {
  -fechaVencimiento
  +estaPagada()
}
class CuotaResponse {
  +pagada
}
ICuota <|.. Cuota
CuotaResponse ..> ICuota
note bottom of Cuota #FFE0E0
  fechaVencimiento se guarda
  y nadie la usa
end note
@enduml
