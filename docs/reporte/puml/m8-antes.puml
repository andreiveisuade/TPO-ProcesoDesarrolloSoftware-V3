@startuml
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 12
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #1D2B4F
skinparam ClassHeaderBackgroundColor #FFFFFF
skinparam ArrowColor #2E75B6
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #B38600
skinparam SequenceLifeLineBorderColor #1D2B4F
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #1D2B4F
skinparam SequenceGroupBackgroundColor #F4F8FC
hide empty members
class Credito {
  -anulado : boolean
  +anular(tieneCobranzas : boolean)
}
class CreditoServiceImpl {
  +anularCredito(id)
}
interface CobranzaRepository {
  +existeCobranzaDelCredito(id)
}
class Cuota
CreditoServiceImpl --> Credito
CreditoServiceImpl --> CobranzaRepository
Cuota --> Credito
note bottom of Credito #FFE0E0
  no navega sus cuotas: no sabe saldo
  ni si está cancelado; el service le
  cuenta si tiene cobranzas
end note
@enduml
